<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.mirx" path="/org/gnome/shell/extensions/mirx/">
    <key name="shortcut" type="as"><default>['&lt;Alt&gt;&lt;Shift&gt;x']</default><summary>Atajo de captura</summary></key>
    <key name="enter-action" type="s"><choices><choice value="copy"/><choice value="save"/></choices><default>'copy'</default><summary>Acción de Enter</summary></key>
    <key name="folder" type="s"><default>'~/Imágenes/Capturas'</default><summary>Carpeta de capturas</summary></key>
    <key name="format" type="s"><choices><choice value="PNG"/><choice value="JPG"/></choices><default>'PNG'</default><summary>Formato de imagen</summary></key>
    <key name="default-color" type="s"><default>'#ff0000'</default><summary>Color predeterminado</summary></key>
    <key name="default-width" type="i"><range min="1" max="30"/><default>3</default><summary>Grosor predeterminado</summary></key>
  </schema>
</schemalist>
