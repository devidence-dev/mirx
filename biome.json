{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/openspec",
      "!**/graphify-out",
      "!**/docs",
      "!**/.agents",
      "!**/.claude",
      "!**/.gir",
      "!**/package-lock.json",
      "!**/lcov.info",
      "!**/schemas/gschemas.compiled"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    },
    "globals": ["global", "log", "logError", "print", "printerr", "imports", "pkg"]
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownProperty": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}
